cabal-version:      3.0
name:               hilda-test-support
version:            0.1.1
synopsis:           Test helpers shared by hilda-core and hilda
description:
  An HTTP server with canned responses, for tests of code that calls a
  provider. Local to this repository; not published to Hackage.
license:            MIT
author:             Shakeeb Alireza
category:           Testing
build-type:         Simple

library
  default-language: GHC2021
  default-extensions:
    LambdaCase
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

  hs-source-dirs:  src
  exposed-modules: Hilda.FakeServer
  build-depends:
    , base        >=4.18 && <5
    , bytestring  >=0.11 && <0.13
    , network     >=3.1  && <3.3
