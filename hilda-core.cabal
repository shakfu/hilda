cabal-version:      3.0
name:               hilda-core
version:            0.2.0
synopsis:           A small coding agent library for OpenAI-compatible chat APIs
description:
  The agent loop of hilda: a client for OpenAI-compatible chat-completions
  servers and OpenRouter, four tools (read, write, edit, bash), permission
  modes, streaming, prompt caching, a context budget and optional
  sub-agents. Start with the "Hilda" module. The command-line program is
  the hilda package.
license:            MIT
license-file:       LICENSE
author:             Shakeeb Alireza
maintainer:         shakeeb.alireza@gmail.com
category:           Development
build-type:         Simple
extra-doc-files:
  CHANGELOG.md
  README.md

source-repository head
  type:     git
  location: https://github.com/shakfu/hilda.git

common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

  build-depends:
    , aeson       >=2.2  && <2.4
    , base        >=4.18 && <5
    , bytestring  >=0.11 && <0.13
    , directory   >=1.3.7 && <1.4
    , filepath    >=1.4  && <1.6
    , text        >=2.0  && <2.2

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Hilda
    Hilda.Agent
    Hilda.Context
    Hilda.Family
    Hilda.Policy
    Hilda.Prompt
    Hilda.Provider
    Hilda.Stream
    Hilda.Tools
    Hilda.Types

  build-depends:
    , async                 >=2.2  && <2.3
    , containers            >=0.6  && <0.8
    , http-client           >=0.7  && <0.8
    , http-client-tls       >=0.3  && <0.5
    , http-types            >=0.12 && <0.13
    , process               >=1.6.9 && <1.7
    , stm                   >=2.5  && <2.6
    , unix                  >=2.7  && <2.9

test-suite spec
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded
  other-modules:
    AgentSpec
    ContextSpec
    FamilySpec
    Hilda.FakeServer
    PolicySpec
    PromptSpec
    ProviderSpec
    StreamSpec
    ToolsSpec

  build-depends:
    , async
    , containers
    , hilda-core
    , hspec                 >=2.10 && <2.12
    , http-client
    , network               >=3.1  && <3.3
    , temporary             >=1.3  && <1.4
    , unix
