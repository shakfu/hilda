cabal-version:      3.0
name:               hilda
version:            0.1.1
synopsis:           A small coding agent for OpenAI-compatible chat APIs
description:
  The hilda command: a coding agent for OpenAI-compatible chat-completions
  servers and OpenRouter. Runs headless, as a REPL, or as an Agent Client
  Protocol server. Built on the hilda-core library. See the README.
license:            MIT
license-file:       LICENSE
author:             Shakeeb Alireza
maintainer:         shakeeb.alireza@gmail.com
category:           Development
build-type:         Simple
extra-doc-files:
  README.md

source-repository head
  type:     git
  location: https://github.com/shakfu/hilda.git
  subdir:   hilda

common shared
  default-language:   GHC2021
  default-extensions:
    DerivingStrategies
    LambdaCase
    OverloadedStrings

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints

  build-depends:
    , aeson       >=2.2  && <2.4
    , base        >=4.18 && <5
    , bytestring  >=0.11 && <0.13
    , directory   >=1.3.7 && <1.4
    , filepath    >=1.4  && <1.6
    , hilda-core  ==0.1.1
    , text        >=2.0  && <2.2
    , time        >=1.9  && <1.15

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules:
    Hilda.Acp
    Hilda.App
    Hilda.Cli
    Hilda.Markdown
    Hilda.Render
    Hilda.Repl
    Hilda.State

  other-modules:   Paths_hilda
  autogen-modules: Paths_hilda

  build-depends:
    , containers            >=0.6  && <0.8
    , isocline              ==1.1.0
    , optparse-applicative  >=0.17 && <0.20
    , unix                  >=2.7  && <2.9

executable hilda
  import:         shared
  hs-source-dirs: app
  main-is:        Main.hs
  ghc-options:    -threaded -rtsopts
  build-depends:  hilda

test-suite spec
  import:         shared
  type:           exitcode-stdio-1.0
  hs-source-dirs: test
  main-is:        Spec.hs
  ghc-options:    -threaded
  build-tool-depends: hilda:hilda
  other-modules:
    AcpSpec
    AppSpec
    CliSpec
    HeadlessSpec
    MarkdownSpec
    RenderSpec
    ReplSpec
    StateSpec

  build-depends:
    , containers
    , hilda-test-support
    , hilda
    , hspec                 >=2.10 && <2.12
    , optparse-applicative
    , process
    , temporary             >=1.3  && <1.4
    , unix
